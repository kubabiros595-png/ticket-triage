    {
      "parameters": {
        "jsCode": "const expected = $('Get expected answers').all().map((item) => item.json);\nconst results = new Map($input.all().map((item) => [item.json.ticket_id, item.json]));\n\nconst mistakes = [];\nlet categoryCorrect = 0;\nlet urgencyCorrect = 0;\nlet bothCorrect = 0;\n\nfor (const ticket of expected) {\n  const result = results.get(ticket.ticket_id) || {};\n  const categoryOk = result.category === ticket.expected_category;\n  const urgencyOk = result.urgency === ticket.expected_urgency;\n  if (categoryOk) categoryCorrect += 1;\n  if (urgencyOk) urgencyCorrect += 1;\n  if (categoryOk && urgencyOk) bothCorrect += 1;\n  if (!categoryOk) mistakes.push(ticket.ticket_id + ' category: ' + (result.category || 'missing') + ' instead of ' + ticket.expected_category);\n  if (!urgencyOk) mistakes.push(ticket.ticket_id + ' urgency: ' + (result.urgency || 'missing') + ' instead of ' + ticket.expected_urgency);\n}\n\nconst rows = [...results.values()];\n\nreturn [{\n  json: {\n    tickets: expected.length,\n    category_correct: categoryCorrect,\n    urgency_correct: urgencyCorrect,\n    both_correct: bothCorrect,\n    needs_human: rows.filter((row) => row.needs_human).length,\n    auto_check_flags: rows.filter((row) => row.auto_checks).length,\n    mistakes: mistakes.join(' | ') || 'none',\n  },\n}];"
      },
      "id": "1a2b0be1-52c8-4ccb-9a87-1a84b923393b",
      "name": "Score results",
